# Optional: raises GitHub API rate limit from 60/hr to 5000/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# Optional: disable GitHub enrichment entirely (true/false). Default: true.
GITHUB_ENRICHMENT_ENABLED=true

# Optional: HTTP timeout in seconds for GitHub API calls. Default: 10.
GITHUB_TIMEOUT_SECONDS=10

# Required only for --scorer gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to call. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: HTTP timeout in seconds for the Gemini API call. Default: 30.
GEMINI_TIMEOUT_SECONDS=30

# Optional: Gemini "thinking" before answering. 0 = off (fastest), -1 = model default.
GEMINI_THINKING_BUDGET=0

# Optional: extra attempts when Gemini is rate-limited/overloaded. Default: 2.
GEMINI_MAX_RETRIES=2

# Optional: candidates processed at the same time (GitHub + scoring). Default: 4.
# Gemini's free tier allows only a few requests per minute; raise with a paid key.
MAX_WORKERS=4
